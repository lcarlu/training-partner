# Copy to backend/.env and fill in. Never commit the real .env.

GARMIN_EMAIL=
GARMIN_PASSWORD=
# Directory where the Garmin session tokens are cached after scripts/garmin_login.py runs.
GARMIN_TOKEN_STORE=.garmin_tokens

# Postgres (see docker-compose.yml at the repo root: `docker compose up -d`). Shared by the
# app-owned tables (journal/plan/sync_log), dlt's `raw` schema, and dbt's `staging`/`marts`
# schemas - one database, several schemas.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=athlete
POSTGRES_PASSWORD=athlete
POSTGRES_DB=athlete
DATABASE_URL=postgresql+psycopg://athlete:athlete@localhost:5432/athlete

# Marathon target (editable later via the Plan page / API).
MARATHON_RACE_DATE=2027-04-11
MARATHON_TARGET_TIME=

CORS_ORIGINS=["http://localhost:5173"]
